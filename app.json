{
  "expo": {
    "name": "ChefStackMobile",
    "slug": "ChefStackMobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/chefstack_logo.png",
    "scheme": "chefstackmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2D6A4F",
        "foregroundImage": "./assets/chefstack_logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/chefstack_logo.png",
      "shortName": "ChefStack",
      "name": "ChefStack",
      "description": "Your ultimate culinary companion.",
      "display": "standalone",
      "themeColor": "#2D6A4F",
      "backgroundColor": "#0F172A",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/chefstack_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2D6A4F",
          "dark": {
            "backgroundColor": "#0F172A"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
